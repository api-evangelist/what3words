{
  "opencollection": "1.0.0",
  "info": {
    "name": "what3words Public Autosuggest Available Languages API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Available Languages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all 3 word address languages supported",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.what3words.com/v3/available-languages"
          },
          "docs": "List all 3 word address languages supported"
        }
      ]
    }
  ],
  "bundled": true
}